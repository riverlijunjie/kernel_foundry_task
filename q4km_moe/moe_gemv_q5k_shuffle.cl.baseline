/*
 * moe_gemv_q5k_shuffle.cl
 *
 * OpenCL MoE kernel for Q5_K on shuffled weight layout, translated from the
 * SYCL/ESIMD source:
 *   runDownMergeQ5KL1_xve_xe2_impl<OPG>  (gemv_q5k_L1.xve-xe2.cpp)
 *
 * The original SYCL kernel uses `load_2d` 2D-tile ESIMD reads to fetch all
 * OPG channels of qs/qh/sl in one go (an XE2-specific optimisation). That
 * memory-access micro-optimisation has no direct 1:1 OpenCL primitive; this
 * translation keeps the exact same *dequantization math* (bit-for-bit
 * identical results) while issuing per-channel scalar/byte loads instead of
 * the 2D block-load tiles -- functionally equivalent, portable OpenCL.
 *
 * Shuffled layout (produced by ShuffleQ5KL1):
 *   pqs  [num_blocks * 128]  -- packed 4-bit lower quants (same packing as Q4_K)
 *   pqh  [num_blocks *  32]  -- packed high bits (1 bit per weight)
 *   psl  [num_blocks *  16]  -- scales/mins/d/dmin (same 16-byte structure as Q4_K)
 *   expert_size = num_blocks * 176   (128 qs + 32 qh + 16 sl)
 *
 * Per shuffled block (256 weights):
 *   Sub-block j (j=0..7) covers 32 weights at positions [j*32 .. j*32+31].
 *   qs layout: qs[j*16+k] = low4(w[j*32+k]) | (low4(w[j*32+16+k]) << 4)
 *   qh layout: qh[j*4+k]  packs the high bit of 8 weights:
 *       bit s of qh[j*4+k] = high_bit(w[j*32 + k + s*4])   for s=0..7
 *   Full weight = low_nibble(qs) | (high_bit(qh) << 4)      (range 0..31)
 *
 * Scale/min reconstruction identical to Q4_K (see moe_gemv_q4k_shuffle.cl).
 *
 * Kernels provided:
 *   group_up_gate_q5k -- MoE up+gate fused GEMV with SiLU(gate) * up activation
 *                        (analogous to group_up_gate_q4k, adapted for Q5_K dequant;
 *                        no direct SYCL/ESIMD source exists for this fusion in the
 *                        Q5_K L1 kernel file, so it mirrors runGroupUpAndGateVecQ4KL1_xve_impl's
 *                        structure with Q5_K's block layout/dequant substituted in)
 *   down_merge_q5k     -- MoE down GEMV with per-expert weighted accumulation
 */

#pragma OPENCL EXTENSION cl_khr_fp16 : enable

/* -----------------------------------------------------------------------
 * Helpers
 * --------------------------------------------------------------------- */
inline float q5k_load_fp16(const __global uchar *p) {
    ushort u = (ushort)p[0] | ((ushort)p[1] << 8);
    return (float)as_half(u);
}

inline void q5k_decode_scales(const __global uchar *psl,
                               float *scale_out, float *min_out)
{
    uint  sl   = (uint)psl[0] | ((uint)psl[1]<<8) | ((uint)psl[2]<<16) | ((uint)psl[3]<<24);
    uint  ml   = (uint)psl[4] | ((uint)psl[5]<<8) | ((uint)psl[6]<<16) | ((uint)psl[7]<<24);
    uint  sh   = (uint)psl[8] | ((uint)psl[9]<<8);
    uint  mh   = (uint)psl[10]| ((uint)psl[11]<<8);
    float d    = q5k_load_fp16(psl + 12);
    float dmin = q5k_load_fp16(psl + 14);

    for (int i = 0; i < 8; i++) {
        uint sq = ((sl >> (i*4)) & 0xF) | (((sh >> (i*2)) & 0x3) << 4);
        uint mq = ((ml >> (i*4)) & 0xF) | (((mh >> (i*2)) & 0x3) << 4);
        scale_out[i] = (float)sq * d;
        min_out[i]   = (float)mq * dmin;
    }
}

/* Sub-block dot for Q5_K: sub-block j, 32 weights.
 * pqs_blk : base of 128-byte qs block
 * pqh_blk : base of 32-byte qh block
 * The high bit of weight[j*32 + k + s*4] is stored in bit s of qh[j*4 + k%4]
 * (same "high_value_mask" layout used by the SYCL kernel):
 *   byte_idx = wi % 4, bit_idx = wi / 4   (wi = weight index within sub-block)
 *   high_bit = (qh_word >> (byte_idx*8 + bit_idx)) & 1
 */
inline float q5k_subblock_dot(const __global uchar *pqs_blk,
                               const __global uchar *pqh_blk,
                               const float *input,
                               float scale, float min_val,
                               int j)
{
    uint qh_word = (uint)pqh_blk[j*4]
                 | ((uint)pqh_blk[j*4+1] << 8)
                 | ((uint)pqh_blk[j*4+2] << 16)
                 | ((uint)pqh_blk[j*4+3] << 24);

    float acc = 0.0f;
    for (int k = 0; k < 16; k++) {
        uchar byte = pqs_blk[j * 16 + k];

        /* Lower half: weight index within sub-block = k */
        float w0 = (float)(byte & 0x0F);
        int byte_idx0 = k % 4;
        int bit_idx0  = k / 4;
        if ((qh_word >> (byte_idx0 * 8 + bit_idx0)) & 1u)
            w0 += 16.0f;
        w0 = w0 * scale - min_val;

        /* Upper half: weight index within sub-block = k + 16 */
        float w1 = (float)((byte >> 4) & 0x0F);
        int byte_idx1 = (k + 16) % 4;
        int bit_idx1  = (k + 16) / 4;
        if ((qh_word >> (byte_idx1 * 8 + bit_idx1)) & 1u)
            w1 += 16.0f;
        w1 = w1 * scale - min_val;

        acc += input[j * 32 + k]      * w0;
        acc += input[j * 32 + 16 + k] * w1;
    }
    return acc;
}

/* =======================================================================
 * Kernel: group_up_gate_q5k
 *
 * MoE fused up+gate GEMV with SiLU activation, using Q5_K dequantization.
 * Structurally identical to group_up_gate_q4k (moe_gemv_q4k_shuffle.cl),
 * translated from runGroupUpAndGateVecQ4KL1_xve_impl<OPG, BS>, but with the
 * Q5_K block layout / dequant math (q5k_decode_scales + q5k_subblock_dot,
 * including the extra `pqh` high-bit section) substituted for Q4_K's.
 *
 * For each token t and selected expert v (index = indexes[t, v] or v):
 *   up_out   = W_up  [index] * x[t]
 *   gate_out = W_gate[index] * x[t]
 *   out[t, v] = silu(gate_out) * up_out           silu(x) = x * sigmoid(x)
 *
 * OPG (outputs-per-group) and BS (Q5K blocks per thread) are compile-time
 * #defines below (OPG=8, BS=1, matching the Q4_K fused up/gate config).
 *
 * Buffer layout:
 *   ups, gates : [num_experts * expert_size]  (expert_size = num_blocks * 176)
 *   indexes    : [token_len * aligned_output_num]  (uint32, may be NULL -> identity)
 *
 * Launch:
 *   local_thread = num_blocks_per_row / BS_UG5   (num_blocks_per_row = input_len/256)
 *   global = (output_len/OPG_UG5 * local_thread, output_num, token_len)
 *   local  = (local_thread, 1, 1)
 * ===================================================================== */
#define OPG_UG5 8
#define BS_UG5  1

__kernel
void group_up_gate_q5k(
    __global const float  *inputs,          /* [token_len * input_len] */
    __global const uchar  *ups,             /* [num_experts * expert_size] */
    __global const uchar  *gates,           /* [num_experts * expert_size] */
    __global const uint   *indexes,         /* [token_len * aligned_output_num] or NULL */
    __global       float  *outputs,         /* [token_len * output_num * output_len] */
    uint output_num,
    uint aligned_output_num,
    uint token_len,
    uint input_len,
    uint output_len
) {
    uint num_blocks_per_row = input_len / 256;
    uint num_blocks         = input_len * output_len / 256;
    uint expert_size        = num_blocks * 176;  /* Q5K: 128 qs + 32 qh + 16 sl */

    uint local_thread = num_blocks_per_row / BS_UG5;

    uint h  = get_group_id(0);
    uint hh = get_local_id(0);
    uint v  = get_group_id(1);
    uint t  = get_group_id(2);

    uint index = indexes ? indexes[t * aligned_output_num + v] : v;

    __local float slm_up  [64 * OPG_UG5];
    __local float slm_gate[64 * OPG_UG5];

    float outUp  [OPG_UG5]; for (int l = 0; l < OPG_UG5; l++) outUp[l]   = 0.0f;
    float outGate[OPG_UG5]; for (int l = 0; l < OPG_UG5; l++) outGate[l] = 0.0f;

    for (uint c = 0; c < BS_UG5; c++) {
        uint blockIdx = hh * BS_UG5 + c;

        float inp[256];
        for (int i = 0; i < 256; i++)
            inp[i] = inputs[t * input_len + 256 * blockIdx + i];

        /* --- up projection --- */
        {
            const __global uchar *weights = ups + (size_t)index * expert_size;
            const __global uchar *pqs_w   = weights;
            const __global uchar *pqh_w   = pqs_w + (size_t)num_blocks * 128;
            const __global uchar *psl_w   = pqh_w + (size_t)num_blocks * 32;

            for (int l = 0; l < OPG_UG5; l++) {
                uint blk_idx = h * OPG_UG5 * num_blocks_per_row + (uint)l * num_blocks_per_row + blockIdx;
                float scale[8], minv[8];
                q5k_decode_scales(psl_w + (size_t)blk_idx * 16, scale, minv);
                float acc = 0.0f;
                for (int j = 0; j < 8; j++)
                    acc += q5k_subblock_dot(pqs_w + (size_t)blk_idx * 128, pqh_w + (size_t)blk_idx * 32,
                                            inp, scale[j], minv[j], j);
                outUp[l] += acc;
            }
        }

        /* --- gate projection --- */
        {
            const __global uchar *weights = gates + (size_t)index * expert_size;
            const __global uchar *pqs_w   = weights;
            const __global uchar *pqh_w   = pqs_w + (size_t)num_blocks * 128;
            const __global uchar *psl_w   = pqh_w + (size_t)num_blocks * 32;

            for (int l = 0; l < OPG_UG5; l++) {
                uint blk_idx = h * OPG_UG5 * num_blocks_per_row + (uint)l * num_blocks_per_row + blockIdx;
                float scale[8], minv[8];
                q5k_decode_scales(psl_w + (size_t)blk_idx * 16, scale, minv);
                float acc = 0.0f;
                for (int j = 0; j < 8; j++)
                    acc += q5k_subblock_dot(pqs_w + (size_t)blk_idx * 128, pqh_w + (size_t)blk_idx * 32,
                                            inp, scale[j], minv[j], j);
                outGate[l] += acc;
            }
        }
    }

    for (int l = 0; l < OPG_UG5; l++) {
        slm_up  [hh * OPG_UG5 + l] = outUp[l];
        slm_gate[hh * OPG_UG5 + l] = outGate[l];
    }

    barrier(CLK_LOCAL_MEM_FENCE);

    if (hh == 0) {
        float accUp  [OPG_UG5]; for (int l = 0; l < OPG_UG5; l++) accUp[l]   = 0.0f;
        float accGate[OPG_UG5]; for (int l = 0; l < OPG_UG5; l++) accGate[l] = 0.0f;
        for (uint i = 0; i < local_thread; i++) {
            for (int l = 0; l < OPG_UG5; l++) {
                accUp[l]   += slm_up  [i * OPG_UG5 + l];
                accGate[l] += slm_gate[i * OPG_UG5 + l];
            }
        }
        /* SiLU(gate) * up  ==  sigmoid(gate) * gate * up */
        for (int l = 0; l < OPG_UG5; l++) {
            float g       = accGate[l];
            float sig     = 1.0f / (1.0f + exp(-g));
            float silu_g  = sig * g;
            outputs[(size_t)t * output_num * output_len + (size_t)v * output_len + h * OPG_UG5 + l] =
                silu_g * accUp[l];
        }
    }
}

/* =======================================================================
 * Kernel: down_merge_q5k
 *
 * MoE down projection: weighted sum over input_num experts, translated
 * from runDownMergeQ5KL1_xve_xe2_impl<OPG>.
 *
 *   out[t] (+)= sum_e efficient[t,e] * ( W_down[index[t,e]] * in[t, e] )
 *
 * OPG (outputs-per-group) is a compile-time #define below (OPG=4 matches
 * the SYCL benchmark-optimal configuration for input_num=8/input_len=512/
 * output_len=2048).
 *
 * Launch:
 *   global = (output_len/OPG_DM5 * num_blocks_per_row, token_len)
 *   local  = (num_blocks_per_row, 1)
 * ===================================================================== */
#define OPG_DM5 4

__kernel
void down_merge_q5k(
    __global const float  *inputs,       /* [token_len * input_num * input_len] */
    __global const uchar  *downs,        /* [num_experts * expert_size], expert_size = num_blocks*176 */
    __global const uint   *indexes,      /* [token_len * aligned_input_num] or NULL */
    __global const float  *efficients,   /* [token_len * aligned_input_num] */
    __global       float  *outputs,      /* [token_len * output_len] */
    uint input_num,
    uint aligned_input_num,
    uint token_len,
    uint input_len,
    uint output_len,
    int  is_acc
) {
    uint num_blocks_per_row = input_len / 256;
    uint num_blocks         = input_len * output_len / 256;
    uint expert_size        = num_blocks * 176;  /* Q5K: 128 qs + 32 qh + 16 sl */

    uint h  = get_group_id(0);
    uint hh = get_local_id(0);
    uint t  = get_group_id(1);

    __local float slm[64 * OPG_DM5];

    float outData[OPG_DM5]; for (int l = 0; l < OPG_DM5; l++) outData[l] = 0.0f;

    for (int e = 0; e < (int)input_num; e++) {
        uint  index     = indexes ? indexes[t * aligned_input_num + e] : (uint)e;
        float efficient = efficients[t * aligned_input_num + e];

        const __global uchar *weights = downs + (size_t)index * expert_size;
        const __global uchar *pqs_w   = weights;
        const __global uchar *pqh_w   = pqs_w + (size_t)num_blocks * 128;
        const __global uchar *psl_w   = pqh_w + (size_t)num_blocks * 32;

        float inp[256];
        for (int i = 0; i < 256; i++)
            inp[i] = inputs[(size_t)t * input_num * input_len + (size_t)e * input_len + 256 * hh + i];

        float expertOut[OPG_DM5];
        for (int l = 0; l < OPG_DM5; l++) {
            uint blk_idx = h * OPG_DM5 * num_blocks_per_row + (uint)l * num_blocks_per_row + hh;
            float scale[8], minv[8];
            q5k_decode_scales(psl_w + (size_t)blk_idx * 16, scale, minv);
            float acc = 0.0f;
            for (int j = 0; j < 8; j++)
                acc += q5k_subblock_dot(pqs_w + (size_t)blk_idx * 128, pqh_w + (size_t)blk_idx * 32,
                                        inp, scale[j], minv[j], j);
            expertOut[l] = acc;
        }

        for (int l = 0; l < OPG_DM5; l++)
            outData[l] += expertOut[l] * efficient;
    }

    for (int l = 0; l < OPG_DM5; l++)
        slm[hh * OPG_DM5 + l] = outData[l];

    barrier(CLK_LOCAL_MEM_FENCE);

    if (hh == 0) {
        float accOut[OPG_DM5]; for (int l = 0; l < OPG_DM5; l++) accOut[l] = 0.0f;
        for (uint i = 0; i < num_blocks_per_row; i++)
            for (int l = 0; l < OPG_DM5; l++)
                accOut[l] += slm[i * OPG_DM5 + l];
        if (is_acc) {
            for (int l = 0; l < OPG_DM5; l++)
                accOut[l] += outputs[(size_t)t * output_len + h * OPG_DM5 + l];
        }
        for (int l = 0; l < OPG_DM5; l++)
            outputs[(size_t)t * output_len + h * OPG_DM5 + l] = accOut[l];
    }
}
